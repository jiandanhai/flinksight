{
  "name": "flinksight-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "concurrently \"npm run mock\" \"npm run dev\"",
    "mock": "node src/mocks/browser.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen-api": "npx tsx ./scripts/swagger-openapi-to-axios.ts --swagger=../flinksight-backend/build/openapi.json --outdir=./src/api --baseURL=\"import.meta.env.VITE_API_BASE_URL || '/api'\" --emitStatic=auto --verbose=true",
    "prebuild": "npm run gen-api"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/plots": "^2.6.3",
    "@ant-design/pro-components": "^2.8.10",
    "@antv/g2plot": "^2.4.33",
    "@apidevtools/swagger-parser": "^12.0.0",
    "antd": "^5.26.6",
    "axios": "^1.11.0",
    "echarts": "^6.0.0",
    "msw": "^2.2.2",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "openapi-typescript-codegen": "^0.29.0",
    "swagger-typescript-api": "^13.0.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
